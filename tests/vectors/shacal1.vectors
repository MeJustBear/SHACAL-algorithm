# Golden-векторы SHACAL-1 (см. README.md в этом каталоге).
# Формат: ключ=значение, hex без префиксов, нижний регистр.
# Входы фиксированы: key = байты 00..3f, iv = a0a1a2a3 .., consts = дефолт SHACAL-1.

# --- Блочный примитив: encrypt_block(00010203 04050607 08090a0b 0c0d0e0f 10111213) ---
block_ct = d4b0a13e b74dd153 88d1c00d 8ac7ab1f 8dd437fd

# --- Режимы: encrypt(сообщение из 50 инкрементных байт 0x00..0x31) ---
# Результат включает PKCS#7-дополнение, поэтому длина кратна 20 байт (здесь 60).
ecb = d4b0a13eb74dd15388d1c00d8ac7ab1f8dd437fdf8847942699be438ea15b8fb84f1bb13cc9592bc4798a55717390f2822cd75eff0a279a307fad7ec
